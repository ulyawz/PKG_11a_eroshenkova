<Window x:Class="PicInfoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр свойств изображений" Width="1220" Height="700" MinWidth="820" MinHeight="460"
        AllowDrop="True" Drop="Window_Drop" FontSize="13" FontFamily="Segoe UI"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="14,10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnOpen" Content="📂  Открыть папку…" Margin="0,0,8,0" Click="OpenFolder_Click" />
                <Button x:Name="BtnCancel" Content="⏹  Остановить" Style="{StaticResource SoftButton}"
                        Margin="0,0,20,0" IsEnabled="False" Click="Cancel_Click" />
                <CheckBox x:Name="ChkRecursive" Content="Искать в подпапках" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Text="Поиск по имени:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="SearchBox" Width="200" Padding="6,4" VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource LineBrush}" TextChanged="Search_Changed" />
            </StackPanel>
        </Border>

        <!-- Таблица + предпросмотр -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="340" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="ImagesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0"
                          Background="White" GridLinesVisibility="None" CanUserResizeRows="False"
                          AlternationCount="2" EnableRowVirtualization="True"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowStyle="{StaticResource GridRow}"
                          CellStyle="{StaticResource GridCell}"
                          SelectionChanged="ImagesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя файла" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="80" />
                        <DataGridTextColumn Header="Размер, px" Binding="{Binding Dimensions}" Width="110" />
                        <DataGridTextColumn Header="Разрешение, dpi" Binding="{Binding Resolution}" Width="125" />
                        <DataGridTextColumn Header="Глубина цвета" Binding="{Binding ColorDepth}" Width="115" />
                        <DataGridTextColumn Header="Сжатие" Binding="{Binding Compression}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Карточка предпросмотра -->
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Предпросмотр" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />

                    <Border Grid.Row="1" Background="#F7F8FD" CornerRadius="8">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="PreviewHint" Text="Выберите файл в таблице"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="14" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="PreviewCaption" Grid.Row="2" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                               Foreground="{StaticResource InkBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="14,9"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="ScanBar" Width="280" Height="8" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Перетащите папку в окно или нажмите «Открыть папку…»"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
